[Unit]
Description=CarWatch phone dashboard (webchat :8088)
After=network-online.target
Wants=network-online.target

[Service]
User=petrus
WorkingDirectory=/home/petrus/CarWatch
Environment=CARWATCH_STATE=/home/petrus/.carwatch
Environment=PYTHONPATH=/home/petrus/CarWatch
ExecStart=/usr/bin/python3 -u -m carwatch.webchat --port 8088
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
