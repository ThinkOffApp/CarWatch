[Unit]
Description=CarWatch dial-out reachability (public tunnel to the car dashboard)
After=network-online.target carwatch-chat.service
Wants=network-online.target

[Service]
# Dials OUT so the car is reachable behind any NAT (phone hotspot included),
# ending the park-and-wait trap. Restarts if the tunnel drops; the quick
# tunnel URL changes on restart, so reach.sh re-announces it to the room.
Type=simple
User=petrus
# Absolute path on purpose: a literal $HOME is mangled by systemd's own
# variable expansion, and %h resolves to /root for a SYSTEM service (not the
# User= home) - both crash-looped this service. CarWatch is a single-user Pi
# deployment (update.sh assumes $HOME/CarWatch = /home/petrus/CarWatch).
ExecStart=/usr/bin/env bash -lc '/home/petrus/CarWatch/reach.sh'
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
